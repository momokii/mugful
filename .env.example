# Local-only credentials. Replace the password before using this file as .env.
POSTGRES_DB=mugful
POSTGRES_USER=mugful
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://mugful:replace-with-a-local-only-password@127.0.0.1:5432/mugful
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_ORIGIN=http://127.0.0.1:3001
