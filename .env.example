# Local-only credentials. Replace the password before using this file as .env.
POSTGRES_DB=mugful
POSTGRES_USER=mugful
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://mugful:replace-with-a-local-only-password@127.0.0.1:5432/mugful
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_ORIGIN=http://127.0.0.1:3001
NODE_ENV=development
WEB_ORIGIN=http://127.0.0.1:3000
REGISTRATION_DEFAULT_ENABLED=false
LOCAL_AUTH_BYPASS_EMAIL_VERIFICATION=false
NEXT_PUBLIC_REGISTRATION_ENABLED=false
SESSION_TOKEN_PEPPER=replace-with-a-local-only-session-token-pepper
CSRF_SECRET=replace-with-a-local-only-csrf-secret
RATE_LIMIT_PRINCIPAL_PEPPER=replace-with-a-local-only-rate-limit-principal-pepper
IDENTITY_TOKEN_PEPPER=replace-with-a-local-only-identity-token-pepper
INVITE_TOKEN_PEPPER=replace-with-a-local-only-invite-token-pepper
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Mugful <noreply@mugful.test>

# WebRTC TURN for Together Room (v1.1) — optional for local STUN-only dev, required for production two-network calls
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
